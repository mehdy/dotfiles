/**
 * Rofi theme: solid, dark, minimal.
 * Accents match Hyprland / waybar / dunst (cyan → green), used sparingly:
 * cyan for the selection and search matches, green for active entries
 * (e.g. the connected network in networkmanager-dmenu).
 **/

configuration {
	modi:                       "drun,calc,filebrowser,emoji,window,run";
	show-icons:                 true;
	display-drun:               "Apps";
	display-run:                "Run";
	display-filebrowser:        "Files";
	display-window:             "Windows";
	display-calc:               "Calc";
	display-emoji:              "Emoji";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
}

* {
	font:             "Noto Sans 11";

	bg:               #0E1014;   /* window */
	surface:          #161920;   /* search field, message box */
	selection:        #1C2633;   /* selected row: cyan tinted, not a solid bar */
	line:             #232731;   /* borders and dividers */
	fg:               #D8DCE3;
	fg-bright:        #FFFFFF;
	muted:            #6B7280;
	accent:           #33CCFF;
	active:           #00FF99;
	urgent:           #F53C3C;

	background-color: transparent;  /* children draw on the window's solid bg */
	text-color:       @fg;
}

window {
	location:         center;
	anchor:           center;
	width:            640px;
	border:           1px solid;
	border-color:     @line;
	border-radius:    12px;
	background-color: @bg;
}

mainbox {
	spacing:          0px;
	padding:          0px;
	children:         [ "inputbar", "message", "listview" ];
}

/*----- Search -----*/
inputbar {
	spacing:          12px;
	padding:          16px 18px;
	border:           0px 0px 1px 0px;
	border-color:     @line;
	children:         [ "textbox-search", "prompt", "entry", "num-filtered-rows" ];
}
textbox-search {
	expand:           false;
	str:              "󰍉";
	font:             "Hack Nerd Font 13";
	text-color:       @muted;
	vertical-align:   0.5;
}
prompt {
	text-color:       @accent;
	vertical-align:   0.5;
}
entry {
	text-color:       @fg-bright;
	cursor:           text;
	placeholder:      "Search";
	placeholder-color: @muted;
	vertical-align:   0.5;
}
num-filtered-rows {
	expand:           false;
	text-color:       @muted;
	vertical-align:   0.5;
}

/*----- Message (e.g. dmenu -mesg) -----*/
message {
	padding:          12px 12px 0px 12px;
}
textbox {
	padding:          10px 12px;
	border-radius:    8px;
	background-color: @surface;
	text-color:       @fg;
	markup:           true;
	vertical-align:   0.5;
}
error-message {
	padding:          16px;
	background-color: @bg;
	text-color:       @fg;
}

/*----- List -----*/
listview {
	lines:            8;
	columns:          1;
	cycle:            true;
	dynamic:          true;
	fixed-height:     false;
	scrollbar:        false;
	spacing:          2px;
	padding:          8px;
}

element {
	spacing:          12px;
	padding:          9px 12px;
	border-radius:    8px;
	cursor:           pointer;
}
element normal.normal,
element alternate.normal  { background-color: transparent; text-color: @fg; }
element normal.active,
element alternate.active  { background-color: transparent; text-color: @active; }
element normal.urgent,
element alternate.urgent  { background-color: transparent; text-color: @urgent; }
element selected.normal   { background-color: @selection;  text-color: @fg-bright; }
element selected.active   { background-color: @selection;  text-color: @active; }
element selected.urgent   { background-color: @selection;  text-color: @urgent; }

element-icon {
	size:             22px;
	cursor:           inherit;
}
element-text {
	text-color:       inherit;
	highlight:        bold #33CCFF;  /* the part matching the search */
	cursor:           inherit;
	vertical-align:   0.5;
}

/* Hidden: switch modes with Ctrl+Tab / Shift+→ (Ctrl+Shift+Tab / Shift+← back) */
mode-switcher {
	enabled:          false;
}
